{
  "name": "@bit-ds/react",
  "version": "0.1.2",
  "type": "module",
  "description": "bit design system: React components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doosemavis/bit-design-system.git",
    "directory": "packages/react"
  },
  "homepage": "https://doosemavis.github.io/bit-design-system/",
  "bugs": {
    "url": "https://github.com/doosemavis/bit-design-system/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "css",
    "retro"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css",
    "./themes/*": "./dist/themes/*"
  },
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "node scripts/verify-dist.mjs",
    "prepack": "node scripts/prepack.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@bit-ds/core": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "axe-core": "^4.10.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
