# Project npm settings, committed on purpose (security.md C1). supply-chain.test.mjs allows only these
# lines, so a registry token can never be added here; put tokens in ~/.npmrc. ignore-scripts: no
# dependency runs an install script. `npm run <name>` still runs that script (but not its pre/post
# hooks), and `npm pack` passes --ignore-scripts=false so prepack copies README.md and LICENSE in.
ignore-scripts=true
