{
  "name": "bit-design-system",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @bit-ds/react",
    "verify": "npm run verify -w @bit-ds/react",
    "test": "npm test --workspaces --if-present",
    "test:coverage": "npm run test:coverage -w @bit-ds/react",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "versions": "node scripts/versions.mjs --out apps/gallery/public/versions.json",
    "logo:svg": "node scripts/build-logo-svg.mjs",
    "icons": "node scripts/build-icons.mjs",
    "smoke": "node scripts/smoke-consumer.mjs",
    "smoke:full": "node scripts/smoke-consumer.mjs --vite",
    "gallery": "npm run build && npm run dev -w @bit-ds/gallery",
    "dev": "npm run gallery",
    "gallery:build": "npm run build && npm run build -w @bit-ds/gallery",
    "preview": "npm run gallery:build && npm run preview -w @bit-ds/gallery",
    "e2e": "npm run e2e -w @bit-ds/gallery"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.64.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
