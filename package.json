{
  "name": "bit-design-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm --filter @bit-ds/react build",
    "verify": "pnpm --filter @bit-ds/react verify",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:coverage": "pnpm --filter @bit-ds/react test:coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "storybook": "pnpm --filter @bit-ds/docs storybook",
    "storybook:build": "pnpm --filter @bit-ds/docs build",
    "logo:svg": "node scripts/build-logo-svg.mjs",
    "smoke": "node scripts/smoke-consumer.mjs",
    "gallery": "pnpm build && pnpm --filter @bit-ds/gallery dev",
    "dev": "pnpm gallery",
    "gallery:build": "pnpm build && pnpm --filter @bit-ds/gallery build",
    "e2e": "pnpm --filter @bit-ds/gallery e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
